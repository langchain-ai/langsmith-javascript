{
  "$schema": "https://typedoc.org/schema.json",
  "out": "_build/api_refs",
  "sort": ["kind", "visibility", "instance-first", "required-first", "alphabetical"],
  "plugin": ["typedoc-plugin-expand-object-like-types", "./scripts/typedoc-plugin.cjs"],
  "tsconfig": "./tsconfig.json",
  "excludePrivate": true,
  "excludeInternal": true,
  "excludeExternals": false,
  "excludeNotDocumented": false,
  "includeVersion": true,
  "sourceLinkTemplate": "https://github.com/langchain-ai/langsmith-javascript/blob/{gitRevision}/{path}#L{line}",
  "logLevel": "Error",
  "name": "LangSmith",
  "skipErrorChecking": false,
  "exclude": ["dist"],
  "hostedBaseUrl": "https://docs.smith.langchain.com/reference/js/",
  "entryPoints": [
    "src/lib/client.ts",
    "src/lib/run_trees.ts",
    "src/lib/traceable.ts",
    "src/lib/evaluation/index.ts",
    "src/lib/schemas.ts",
    "src/lib/langchain.ts",
    "src/lib/jest/index.ts",
    "src/lib/jest/reporter.ts",
    "src/lib/vitest/index.ts",
    "src/lib/vitest/reporter.ts",
    "src/lib/wrappers/index.ts",
    "src/lib/anonymizer/index.ts",
    "src/lib/wrappers/anthropic.ts",
    "src/lib/wrappers/openai.ts",
    "src/lib/wrappers/gemini.ts",
    "src/lib/wrappers/openai_agents.ts",
    "src/lib/singletons/traceable.ts",
    "src/lib/utils/jestlike/index.ts",
    "src/lib/experimental/otel/setup.ts",
    "src/lib/experimental/otel/exporter.ts",
    "src/lib/experimental/otel/processor.ts",
    "src/lib/experimental/vercel/index.ts",
    "src/lib/experimental/anthropic/index.ts",
    "src/lib/sandbox/index.ts"
  ]
}

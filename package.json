  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./client": {
      "import": "./dist/lib/client.mjs",
      "require": "./dist/lib/client.js"
    },
    "./*.mjs": {
      "default": "./dist/*.mjs"
    },
    "./*.js": {
      "default": "./dist/*.js"
    },
    "./*": {
      "import": "./dist/*.mjs",
      "require": "./dist/*.js"
    }
  },
  "keywords": [
    "LLM",
    "Tracing",
    "Evaluation",
    "LangChain"
  ],
  "peerDependencies": {
    "@opentelemetry/api": "*",
    "@opentelemetry/exporter-trace-otlp-proto": "*",
    "@opentelemetry/sdk-trace-base": "*",
    "openai": "*",
    "ws": ">=7"
  },
  "peerDependenciesMeta": {
    "openai": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    },
    "@opentelemetry/exporter-trace-otlp-proto": {
